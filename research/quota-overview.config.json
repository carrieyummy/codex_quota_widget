    { "label": "向量嵌入", "path": "/v1/organization/usage/embeddings" },
    { "label": "向量存储", "path": "/v1/organization/usage/vector_stores" },
    { "label": "代码解释器", "path": "/v1/organization/usage/code_interpreter_sessions" },
    { "label": "结构化决策", "path": "/v1/organization/usage/decisions" },
    { "label": "内容审核", "path": "/v1/organization/usage/moderations" },
    { "label": "文件搜索", "path": "/v1/organization/usage/file_search_calls" },
