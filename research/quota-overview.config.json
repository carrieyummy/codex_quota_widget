    "prices": "https://developers.openai.com/api/docs/pricing",
    "limits": "https://developers.openai.com/api/docs/guides/spend-limits",
    "rates": "https://developers.openai.com/api/docs/guides/rate-limits",
    "codex": "https://learn.chatgpt.com/docs/app-server"
  }
